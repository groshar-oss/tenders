# מסד נתונים (Supabase): סיסמת התפקיד tenders_app + מזהה הפרויקט. או DATABASE_URL מלא.
DB_PASSWORD=
SUPABASE_REF=
# SUPABASE_REGION=eu-central-1
# DATABASE_URL=

# כניסה עם Google ושליחת מייל (אפשר להשתמש באותו OAuth client של מערכת ההוצאות, עם redirect חדש: <APP_URL>/api/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# דירוג ובדיקת תנאי סף
GEMINI_API_KEY=

# סודות: מחרוזות אקראיות ארוכות
SESSION_SECRET=
CRON_SECRET=

# אופציונלי
# APP_URL=https://groshar-tenders.vercel.app
# FIRECRAWL_API_KEY=   # גיבוי אם מנהל הרכש חוסם את שרתי Vercel
